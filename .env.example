# Copy to .env and change the values. Never commit .env.
DB_NAME=todo_app
DB_USER=todo_user
DB_PASSWORD=change_this_demo_password
DB_ROOT_PASSWORD=change_this_root_password
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Gunicorn tuning (relevant for the load-test analysis)
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
